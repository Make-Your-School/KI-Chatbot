# Caddy reverse proxy for ki-hackdays.de.
# TLS certificates are obtained automatically via Let's Encrypt.
#
# Install:    apt install caddy
# Place at:   /etc/caddy/Caddyfile
# Apply:      systemctl reload caddy

ki-hackdays.de, www.ki-hackdays.de {
	# Compress everything EXCEPT the SSE chat stream. Caddy's encode buffers
	# chunks before flushing them, which turns live token streaming into "wait
	# for the whole response, then dump it". `Cache-Control: no-transform` is
	# not enough — encode ignores it.
	@compressible not path /api/chat
	encode @compressible zstd gzip

	# SSE needs flushing, not buffering
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
	}

	header {
		# Basic hardening
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		# Don't leak the Caddy version
		-Server

		# The frontend has no inline scripts or styles, so everything except
		# images can be locked to same-origin. Images have to stay open to
		# https: because they are raw URLs from arbitrary material repos.
		# If you ever add an inline <script> or a CDN, this header needs to
		# change or the page will silently stop working — check the browser
		# console after any frontend change.
		Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; style-src 'self'; script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
	}

	# Basic request-size ceiling. SSE responses can be long, but POSTed chat
	# bodies are small (history is capped server-side too).
	request_body {
		max_size 1MB
	}
}
