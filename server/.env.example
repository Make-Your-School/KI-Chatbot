# Copy this file to .env and fill in real values.

# ─── LLM-Anbieter ───────────────────────────────────────────────────────────
# Mindestens einer von Gemini oder OpenRouter muss konfiguriert sein.
# PROVIDER_ORDER bestimmt, in welcher Reihenfolge sie probiert werden — der
# erste, der eine 200 zurückgibt, gewinnt. Bei 4xx/5xx/Netzwerkfehler wird der
# nächste versucht.
#
# Die Modell-Listen leben NICHT in dieser .env, sondern git-versioniert in:
#   server/models/gemini.txt
#   server/models/openrouter.txt
# Beide werden live (mtime-cached) gelesen, kein Service-Restart nötig.
PROVIDER_ORDER=gemini,openrouter

# Google AI Studio (Gemini, free tier)
# Key holen unter: https://aistudio.google.com/app/apikey
# Wir nutzen den OpenAI-kompatiblen Endpoint, daher reicht der Key.
# https://ai.google.dev/gemini-api/docs/openai
GEMINI_API_KEY=

# OpenRouter (Backup, wenn Gemini ausfällt — oder umgekehrt via PROVIDER_ORDER)
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://ki-hackdays.de
OPENROUTER_SITE_NAME=KI Hackdays

# HMAC secret for signing session cookies (generate with: openssl rand -hex 32)
# Bei NODE_ENV=production startet der Server NICHT, wenn hier der Platzhalter
# steht oder der Wert kuerzer als 32 Zeichen ist.
AUTH_SECRET=change-me-to-a-long-random-string

# Wie lange ein Login gilt. Die Session laeuft nie laenger als der Schulcode
# selbst — der kuerzere von beiden gewinnt.
SESSION_TTL_DAYS=7

# Server
PORT=3000
# In Produktion IMMER 127.0.0.1 — Caddy terminiert TLS und proxied lokal weiter.
# 0.0.0.0 nur für lokale Dev-Tests mit anderen Geräten im LAN.
HOST=127.0.0.1
NODE_ENV=development

# ─── Rate Limits ────────────────────────────────────────────────────────────
# Drei unabhaengige Tages-Budgets. Alle drei muessen Platz haben, bevor eines
# belastet wird.
#
#   CODE     schuetzt das API-Budget eines (ggf. geteilten) Schulcodes.
#            Pro Code ueberschreibbar:  bun scripts/code.ts new ... --limit=400
#   SESSION  pro Login. Wer sich neu einloggt, bekommt ein frisches Budget —
#            das ist eine Hoeflichkeitsgrenze, keine Sicherheitsgrenze.
#   BROWSER  pro Browser (zufaellige ID in localStorage). Das ist die Grenze,
#            die bei einem geteilten Event-Code wirklich greift.
#
# 0 schaltet ein Budget ab.
RATE_LIMIT_PER_CODE_PER_DAY=200
RATE_LIMIT_PER_SESSION_PER_DAY=40
RATE_LIMIT_PER_BROWSER_PER_DAY=50

# Login-Versuche pro IP und Stunde. Muss grosszuegig sein: eine ganze Schule
# haengt hinter einer NAT-Adresse. Brute Force ist hier nicht das Risiko —
# 6 Zeichen aus 32 sind rund 10^9 Kombinationen.
RATE_LIMIT_LOGIN_PER_IP_PER_HOUR=200

# Paths
KNOWLEDGE_DB_PATH=./data/knowledge.db
CODES_DB_PATH=./data/codes.db
FRONTEND_DIST=../frontend

# RAG
RAG_TOP_K=5
EMBEDDING_MODEL=Xenova/multilingual-e5-small

# Optionales Debug-Logging fuer Chat/RAG-Pipeline.
# 1 = an, leer/0 = aus.
# DEBUG_CHAT_PIPELINE loggt Treffer, Chunks, Ressourcen, Bildauswahl,
# Provider-Auswahl und Modellwahl.
# DEBUG_CHAT_INCLUDE_CONTENT loggt zusaetzlich Vorschauen von User-Message,
# RAG-Kontext und Assistant-Antwort. Nur kurzzeitig aktivieren.
DEBUG_CHAT_PIPELINE=
DEBUG_CHAT_INCLUDE_CONTENT=
DEBUG_CHAT_PREVIEW_CHARS=240

# Optional: GitHub token (avoids API rate limit during embedding)
# GITHUB_TOKEN=ghp_...

# ─── Statistik ──────────────────────────────────────────────────────────────
# Nur Tageszaehler, keine Ereignisse. Eigene Datei, damit das Loeschen der
# Statistik die Schulcodes nicht gefaehrden kann.
STATS_DB_PATH=./data/stats.db
# Zahlen aelter als das werden beim Start geloescht. 800 Tage halten ein
# volles Vorjahr sichtbar.
STATS_RETENTION_DAYS=800
