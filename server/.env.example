# Copy this file to .env and fill in real values.

# ─── LLM-Anbieter ───────────────────────────────────────────────────────────
# Mindestens einer von Gemini oder OpenRouter muss konfiguriert sein.
# PROVIDER_ORDER bestimmt, in welcher Reihenfolge sie probiert werden — der
# erste, der eine 200 zurückgibt, gewinnt. Bei 4xx/5xx/Netzwerkfehler wird der
# nächste versucht.
#
# Die Modell-Listen leben NICHT in dieser .env, sondern git-versioniert in:
#   server/models/gemini.txt
#   server/models/openrouter.txt
# Beide werden live (mtime-cached) gelesen, kein Service-Restart nötig.
PROVIDER_ORDER=gemini,openrouter

# Google AI Studio (Gemini, free tier)
# Key holen unter: https://aistudio.google.com/app/apikey
# Wir nutzen den OpenAI-kompatiblen Endpoint, daher reicht der Key.
# https://ai.google.dev/gemini-api/docs/openai
GEMINI_API_KEY=

# OpenRouter (Backup, wenn Gemini ausfällt — oder umgekehrt via PROVIDER_ORDER)
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://ki-hackdays.de
OPENROUTER_SITE_NAME=KI Hackdays

# HMAC secret for signing session cookies (generate with: openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string

# Debug only: Login mit Schulcode komplett umgehen.
# Nur kurzzeitig zum Testen aktivieren und danach wieder ausschalten.
DEBUG_BYPASS_AUTH=false

# Server
PORT=3000
# In Produktion IMMER 127.0.0.1 — Caddy terminiert TLS und proxied lokal weiter.
# 0.0.0.0 nur für lokale Dev-Tests mit anderen Geräten im LAN.
HOST=127.0.0.1
NODE_ENV=development

# Rate limit per Schulcode per Tag
RATE_LIMIT_PER_CODE_PER_DAY=50

# Paths
KNOWLEDGE_DB_PATH=./data/knowledge.db
CODES_DB_PATH=./data/codes.db
FRONTEND_DIST=../frontend

# RAG
RAG_TOP_K=5
EMBEDDING_MODEL=Xenova/multilingual-e5-small

# Optionales Debug-Logging fuer Chat/RAG-Pipeline.
# 1 = an, leer/0 = aus.
# DEBUG_CHAT_PIPELINE loggt Treffer, Chunks, Ressourcen, Bildauswahl,
# Provider-Auswahl und Modellwahl.
# DEBUG_CHAT_INCLUDE_CONTENT loggt zusaetzlich Vorschauen von User-Message,
# RAG-Kontext und Assistant-Antwort. Nur kurzzeitig aktivieren.
DEBUG_CHAT_PIPELINE=
DEBUG_CHAT_INCLUDE_CONTENT=
DEBUG_CHAT_PREVIEW_CHARS=240

# Optional: GitHub token (avoids API rate limit during embedding)
# GITHUB_TOKEN=ghp_...
